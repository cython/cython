    ]

    # String values
    str_characters = [
        '\0', 'a', 'z',  # ASCII
        '\x80', '\xff',  # Latin1
        '\u0100', '\uffff',  # BMP
        '\U00100000', '\U0010ffff'  # Astral
    ]
    str_values = str_characters + [
        ch * i for i in range(10, 12) for ch in str_characters
    ]
    str_object_values = str_values + [
        Wrapped(ch) for ch in str_characters
    ]
    bytes_characters = [
        b'\0', b'a', b'z',  # ASCII
        b'\x80', b'\xff',  # Latin1
    ]
    bytes_values = bytes_characters +  [
        ch * length for length in (2, 10, 11) for ch in bytes_characters
    ]
    bytearray_values = [bytearray(b) for b in bytes_values]
    bytes_object_values = bytes_values + bytearray_values + [
        Wrapped(ch) for ch in bytes_characters
    ]

    # Code generation
    comparisons = ''.join([
        f"\n        a {op} b,"
        for op in comparison_operators
    ])

    py_comparisons = ','.join([
        f"a{op}b"
        for op in comparison_operators
    ])

    error_doctest_template = (
        f"\n    >>> try: %(funcname)s(%(simple_value)r,None)"
        f"\n    ... except TypeError: pass"
        f"\n    ... else: assert False"
        f"\n    >>> try: %(funcname)s(None,%(simple_value)r)"
        f"\n    ... except TypeError: pass"
        f"\n    ... else: assert False"
        f"\n    >>> try: %(funcname)s(None,None)"
        f"\n    ... except TypeError: pass"
        f"\n    ... else: assert False"
    )

    simple_values = {
        'int': 1,
        'float': 1.,
        'numobject': 1,
        'str': 'a',
        'strobject': 'a',
        'bytes': b'a',
        'bytesobject': b'a',
        'bytearray': bytearray(b'a'),
        'object': 1,
    }

    def escape_value(value):
        return repr(value).encode('unicode_escape').decode('latin1')

    def doctests(values1, values2):
        return [
            (
            f"\n    >>> a = {escape_value(value1)}; b = {escape_value(value2)}; run_test(%(funcname)s, a, b, ({py_comparisons}))"
            f"\n    {tuple(opfunc(value1, value2) for opfunc in operators)!r}"
            )
            for value1 in values1
            for value2 in values2
        ]

    doctest_templates = {
        (typename1, typename2): ''.join(doctests(values1, values2)) + error_doctest_template
        for typename1, values1 in [('int', int_values), ('float', float_values), ('numobject', num_object_values)]
        for typename2, values2 in [('int', int_values), ('float', float_values), ('numobject', num_object_values)]
    }
    doctest_templates.update({
        (typename1, typename2): ''.join(doctests(values1, values2)) + error_doctest_template
        for typename1, values1 in [('str', str_values), ('strobject', str_values)]
        for typename2, values2 in [('str', str_values), ('strobject', str_object_values)]
    })
    doctest_templates.update({
        (typename1, typename2): ''.join(doctests(values1, values2)) + error_doctest_template
        for typename1, values1 in [
            ('bytes', bytes_values), ('bytearray', bytearray_values), ('bytesobject', bytes_object_values)]
        for typename2, values2 in [
            ('bytes', bytes_values), ('bytearray', bytearray_values), ('bytesobject', bytes_object_values)]
    })

    def generate_test_function(type1, type2):
        funcname = f"test_{type1}_{type2}"
        doctests = doctest_templates[(type1, type2)] % {
            'funcname': funcname,
            'simple_value': simple_values[type1 if type2 == 'object' else type2],
        }

        return f'''
def {funcname}(a: {'object' if 'object' in type1 else type1} | None, b: {'object' if 'object' in type2 else type2} | None):
    """{doctests}
    """
    return ({comparisons}
    )

'''

    test_functions = [
        generate_test_function(type1, type2)
        for type1 in ('numobject', 'int', 'float')
        for type2 in ('numobject', 'int', 'float')
    ] + [
        generate_test_function(type1, type2)
        for type1 in ('strobject', 'str')
        for type2 in ('strobject', 'str')
    ] + [
        generate_test_function(type1, type2)
        for type1 in ('bytesobject', 'bytes', 'bytearray')
        for type2 in ('bytesobject', 'bytes', 'bytearray')
    ]

    stats_lines = []

    return test_functions, stats_lines


def _regen_test_file(file_path):
    with open(file_path) as f:
        lines = iter(f)
        start_lines = []
        end_lines = []
        for line in lines:
            start_lines.append(line)
            if line.startswith('###### ') and 'START' in line:
                break
        for line in lines:
            if line.startswith('###### ') and 'END' in line:
                end_lines.append(line)
                break
        end_lines.extend(lines)

    code, stats = _gen_test_code()

    from itertools import chain
    with open(file_path, 'w') as f:
        f.writelines(chain(start_lines, stats, code, end_lines))


if __name__ == '__main__':
    _regen_test_file(__file__)
