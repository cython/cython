######## pkg1/pkg11/feature_memoryview.pyx ########
# Using feature "MemoryViews".

def test(ints):
    from array import array
    a = array('i', ints)
    return memview_func(a)

def memview_func(int[:] ints):
    return sum(ints[i] for i in range(len(ints)))


######## pkg1/pkg11/feature_pythonclasses.pyx ########
# Using feature "PythonClasses".

class PyClass:
    def __init__(self, arg):
        self._arg = arg

    @property
    def arg(self):
        return self._arg + 1


def test():
    class InnerInt(int):
        pass

    return PyClass(InnerInt(5)).arg


