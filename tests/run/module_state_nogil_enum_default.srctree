# mode: run
# tag: pep489

PYTHON setup.py build_ext --inplace
PYTHON -c "import demo; assert demo.run() == (3, 7, 3)"

######## setup.py ########

from setuptools import setup
from Cython.Build import cythonize

setup(ext_modules=cythonize("demo.pyx"))

######## demo.pyx ########

# distutils: define_macros = CYTHON_USE_MODULE_STATE=1

cdef enum Mode:
    DEFAULT_MODE = 3
    OTHER_MODE = 7

cdef int enum_default(Mode mode=DEFAULT_MODE) noexcept nogil:
    return mode

cdef int int_default(int mode=DEFAULT_MODE) noexcept nogil:
    return mode

def run():
    cdef int default_result, explicit_result, int_result
    with nogil:
        default_result = enum_default()
        explicit_result = enum_default(OTHER_MODE)
        int_result = int_default()
    return default_result, explicit_result, int_result
